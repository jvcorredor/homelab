---
// Wraps a generated C4 diagram: light card, optional caption, click to
// open the SVG full size. `wide` lets very wide views scroll instead of
// shrinking into illegibility.
interface Props {
  src: { src: string; width: number; height: number };
  alt: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={["diagram", { wide }]}>
  <a href={src.src} target="_blank" rel="noreferrer">
    <img src={src.src} width={src.width} height={src.height} alt={alt} />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
  }

  .diagram a {
    display: block;
  }

  .diagram img {
    display: block;
    max-width: 100%;
    height: auto;
    padding: 0.5rem;
    background: #ffffff;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .diagram.wide {
    overflow-x: auto;
  }

  .diagram.wide img {
    max-width: none;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
